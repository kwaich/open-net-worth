# Open Net Worth — every variable below is OPTIONAL.
#
# The app runs with ZERO configuration: `make setup` && `make start`, or
# `docker compose up`, works with no .env file at all. First run asks where to put
# your working folder and records the choice.
#
# ONE working folder holds everything: data/ cache/ logs/ backups/ inside it.
# Normally you do not set this at all. Set it to FORCE a location (a container, a
# second instance); it overrides the recorded choice.
ONW_ROOT=/var/lib/open-net-worth

# Your AI provider/key, auth password, email ingest and Telegram are configured
# from the running app's Settings UI, not from here — the app stores that config
# itself. The env vars for those below exist only as an alternative for
# scripted/headless deploys that want to seed a value on first boot; once a store
# holds a value, the UI is authoritative and the env var stops being read.
#
# Copy this file to `.env` and uncomment only what you need to change.


# ── Where things live ─────────────────────────────────────────────────────────
# DATA_DIR=~/.open-net-worth/data     # your ledger, accounts, everything money
# CACHE_DIR=~/.open-net-worth/cache   # price/news caches — safe to delete, regenerates
# LOGS_DIR=~/.open-net-worth/logs     # rotating app logs
# ONW_DATABASE_URL=sqlite:///<DATA_DIR>/onw.db   # or e.g. postgresql+psycopg://user:pass@host/db


# ── Server ───────────────────────────────────────────────────────────────────
# HOST=127.0.0.1                      # 0.0.0.0 to listen on the LAN (Docker sets this itself)
# PORT=8080
# CORS_ORIGINS=http://localhost:5174,http://localhost:8080   # comma-separated; "*" = allow all


# ── Auth (instance password) ────────────────────────────────────────────────
# Auth is ON by default and set up from the UI on first run. These let a scripted
# deploy seed it instead.
# AUTH_DISABLED=false                 # true = no login at all (dev only — never expose publicly)
# AUTH_TRUST_LOOPBACK=true            # false = require login even from localhost
# AUTH_PASSWORD=                      # plaintext seed, hashed into auth.json on first boot
# AUTH_PASSWORD_HASH=                 # pbkdf2$... — preferred over AUTH_PASSWORD, used as-is
# AUTH_API_TOKEN=                     # bearer token for scripted/API access
# AUTH_SESSION_KEY=                   # HMAC session-signing key (auto-generated if unset)
# AUTH_SESSION_TTL=2592000            # seconds (default: 30 days)


# ── AI provider (Lucius) ────────────────────────────────────────────────────
# Choose the provider and model in Settings → AI Model; they are not read from the
# environment. A key here is used only while none is saved in Settings.
# AI_MEMORY_MODEL=                    # cheaper model for background memory extraction
# ANTHROPIC_API_KEY=


# ── Telegram connector ──────────────────────────────────────────────────────
# Normally set from Settings → Connectors → Telegram in the UI.
# ONW_DISABLE_TELEGRAM=               # 1 = skip the connector entirely (the API still serves)


# ── Advanced / internal ──────────────────────────────────────────────────────
# Tuning knobs and CLI-transport internals — most installs never touch these.
# ONW_TURN_TIMEOUT_S=1200             # wall-clock cap on one AI turn, in seconds
# ONW_FULL_TOOL_OFFER=                # 1 = skip the tool-offer diet (debugging only)
# ONW_READ_CACHE=0                    # 1 = enable the read-memoisation cache
# ONW_MIGRATE_ASSUME_BACKUP=          # 1 = skip the pre-migrate backup on a non-SQLite DB
# CODEX_HOME=                         # isolated home dir for the Codex CLI model provider
# ONW_CODEX_TRANSPORT=                # exec | app_server
# ONW_CODEX_CLI_TIMEOUT= / ONW_CODEX_CLI_MAX_CONCURRENCY= / ONW_CODEX_CLI_TRUNCATION_RETRIES=
# ONW_CODEX_APP_SERVER_TIMEOUT=
# ONW_CLAUDE_CLI_SESSIONS=1           # 0 = one process per turn instead of a warm session
# ONW_CLAUDE_CLI_TIMEOUT= / ONW_CLAUDE_CLI_MAX_CONCURRENCY= / ONW_CLAUDE_CLI_SESSION_IDLE=
# ONW_CLAUDE_CLI_TRUNCATION_RETRIES=
# ONW_BASE_URL= / ONW_API_TOKEN=      # used by the standalone MCP stdio bridge script only


# ── QA / eval harnesses only — never set these for a normal install ─────────
# ONW_QA_MODE=1 makes the app refuse to boot if DATA_DIR/CACHE_DIR/LOGS_DIR
# resolve into your real ~/.open-net-worth tree — it exists to protect your data
# from an isolated test run, not the other way around.
# ONW_QA_MODE=
# ONW_QA_NONCE=
# ONW_BUILDER_ROOT= / ONW_EVAL_DIR= / ONW_EVAL_ROOT=


# ── Demo mode ────────────────────────────────────────────────────────────────
# Only for a PUBLIC demo of fabricated data (scripts/run_demo.sh sets both) — never on a real book.
# DEMO_MODE=false                     # true = per-visitor AI quotas + the demo lockdown (docs/DEMO.md)
# DEMO_OPEN_ACCESS=false              # true (with DEMO_MODE) = visitors need NO password
# DEMO_TRUSTED_PROXY_HOPS=0           # proxies in front that append to X-Forwarded-For (0 = ignore the header)
